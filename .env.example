# Modèle de .env.local (jamais versionné). Détail : docs/variables-environnement.md
# Envoi des secrets serveur vers Supabase : npm run secrets:sync

# --- Navigateur (seules variables exposées : clés publiques) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Scripts d'administration (poste de l'équipe uniquement) ---
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_SECRET_KEY=sb_secret_...
BACKUP_ENCRYPTION_KEY=
# BACKUP_RETENTION_DAYS=30

# --- Secrets des Edge Functions (envoyés par npm run secrets:sync) ---
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_MODEL_STRONG=gpt-4.1
# OPENAI_MODEL_COACH=
# COACH_GLOBAL_DAILY_TOKENS=3000000
SITE_URL=http://localhost:5180
MAINTENANCE_SECRET=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Economiz <bonjour@votre-domaine.fr>
ALERT_EMAIL=equipe@votre-domaine.fr
# ALERT_ERROR_THRESHOLD=10

# --- Tests de bout en bout ---
E2E_EMAIL=
E2E_PASSWORD=
